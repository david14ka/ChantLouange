<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SplashActivity">

    <!-- Background Image -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bass_guitar_913092_1920"
        android:scaleType="centerCrop" />

    <!-- Dark Overlay for the "Prestige" look -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/splash_background_overlay" />

    <!-- Main Content Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <!-- Logo Container (Circular with border) -->
        <FrameLayout
            android:id="@+id/logo_container"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:background="@drawable/player_bg_glass"
            android:padding="2dp">

            <de.hdodenhof.circleimageview.CircleImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_bible_prestige"
                android:padding="30dp"
                app:civ_circle_background_color="#1AFFFFFF"
                app:civ_border_width="1dp"
                app:civ_border_color="#33FFFFFF" />
        </FrameLayout>

        <!-- Titles -->
        <TextView
            android:id="@+id/txt_chant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Chant et"
            android:textColor="#FFFFFF"
            android:textSize="56sp"
            android:fontFamily="serif"
            android:textStyle="bold"
            android:letterSpacing="-0.02" />

        <TextView
            android:id="@+id/txt_louange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-16dp"
            android:text="Louange"
            android:textColor="#FFFFFF"
            android:textSize="56sp"
            android:fontFamily="serif"
            android:textStyle="bold"
            android:letterSpacing="-0.02" />

        <!-- Slogan / Verse -->
        <TextView
            android:id="@+id/txt_slogan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Que tout ce qui respire loue l'Éternel ! \n(Psaume 150:6)"
            android:textColor="#BDBDBD"
            android:textSize="18sp"
            android:fontFamily="serif"
            android:textStyle="italic"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2" />

        <!-- Circular Action Button -->
        <ImageButton
            android:id="@+id/btn_enter"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="48dp"
            android:background="@drawable/bg_circle_red"
            android:src="@drawable/ic_chevron_down_white"
            android:elevation="8dp"
            android:contentDescription="Enter Application" />

    </LinearLayout>

    <!-- Footer Information -->
    <LinearLayout
        android:id="@+id/footer_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="32dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            
            <View android:layout_width="40dp" android:layout_height="0.5dp" android:background="#33FFFFFF" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:text="VERSION 3.0"
                android:textColor="#66FFFFFF"
                android:textSize="10sp"
                android:letterSpacing="0.2"
                android:textAllCaps="true" />
            <View android:layout_width="40dp" android:layout_height="0.5dp" android:background="#33FFFFFF" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Copyright 2026"
            android:textColor="#4DFFFFFF"
            android:textSize="9sp"
            android:letterSpacing="0.1"
            android:textAllCaps="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="© 2026"
            android:textColor="#33FFFFFF"
            android:textSize="8sp"
            android:letterSpacing="0.05"
            android:textAllCaps="true" />

    </LinearLayout>

</FrameLayout>