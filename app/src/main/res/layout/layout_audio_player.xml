<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/audio_player_card"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="@drawable/player_bg_glass"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="10dp"
    android:paddingEnd="20dp"
    android:elevation="4dp">

    <!-- Play Button with Red Circle -->
    <FrameLayout
        android:id="@+id/btn_audio_play_container"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_circle_red"
        android:elevation="6dp">

        <ProgressBar
            android:id="@+id/audio_loading"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/white"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btn_audio_play"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_play"
            android:padding="14dp"
            app:tint="@color/white"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <!-- Content Area: Title, Time and Seekbar -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:orientation="vertical">

        <!-- Top Row: Title and Time -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/txt_audio_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/layout_time"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.05"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="TITRE DU CHANT"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/layout_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txt_audio_current_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#BCBCBC"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" / "
                    android:textColor="#88BCBCBC"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txt_audio_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#BCBCBC"
                    android:textSize="12sp" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Minimalist Seekbar -->
        <SeekBar
            android:id="@+id/audio_seekbar"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:progressDrawable="@drawable/seekbar_progress_premium"
            android:thumb="@null"
            android:splitTrack="false"
            android:max="100"
            android:progress="0" />

    </LinearLayout>

</LinearLayout>

