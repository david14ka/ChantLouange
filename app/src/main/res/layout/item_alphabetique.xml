<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_4">

    <!-- Primary Card for actual song items -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@drawable/song_item_bg_glass"
        android:paddingHorizontal="16dp">

        <!-- Hymn Number box -->
        <FrameLayout
            android:id="@+id/box_number"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/song_number_bg"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/txt_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                tools:text="344B"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:fontFamily="serif"
                android:textStyle="italic|bold" />
        </FrameLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/txt_tittle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:ellipsize="end"
            android:maxLines="2"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/box_number"
            app:layout_constraintEnd_toStartOf="@+id/icons_container" />

        <!-- Icons Container -->
        <LinearLayout
            android:id="@+id/icons_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Partition Icon -->
            <ImageView
                android:id="@+id/ic_partition"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_partition_list"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Play Icon -->
            <ImageView
                android:id="@+id/note"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_play_red"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Favorite Icon -->
            <ImageView
                android:id="@+id/fav"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_bookmark"
                app:tint="#E53935"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Chevron -->
            <ImageView
                android:id="@+id/chevron_alphabetique"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/forward_24px"
                app:tint="#66FFFFFF" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Alphabet Section Header overlayed on top, but effectively separates sections -->
    <!-- Usually when ListFragment encounters an item with negative ID, it hides other
         fields and shows txt_letter. We just need to ensure txt_letter has a transparent
         or matching background to hover over the list elegantly. -->
    <TextView
        android:id="@+id/txt_letter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/spacing_6"
        android:text="A"
        android:textColor="@color/tertiary_fixed"
        android:textSize="48sp"
        android:fontFamily="serif"
        android:gravity="center"
        android:visibility="gone"
        android:background="@android:color/transparent" /> <!-- Fully transparent for the new background image mode -->

</FrameLayout>