<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/about_surface" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:right="390dp"> <!-- Assuming a large width, adjust if needed -->
        <shape android:shape="rectangle">
            <solid android:color="@color/about_accent" />
            <corners
                android:topLeftRadius="12dp"
                android:bottomLeftRadius="12dp" />
        </shape>
    </item>
</layer-list>
